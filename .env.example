# Server only. Never prefix secrets with VITE_.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4
# Optional for public repositories; recommended for GitHub rate limits and code search.
GITHUB_TOKEN=
PORT=3001
HOST=127.0.0.1
# Optional comma-separated allowlist, e.g. owner/repo,another/repo
GITHUB_ALLOWED_REPOS=
# Issue Forensics inspects only this many days before the first report (1-30).
FORENSICS_WINDOW_DAYS=7
# Chrome extension ID after loading the unpacked extension (optional for local development).
EXTENSION_ID=
# Only the public backend address is compiled into the extension.
VITE_API_URL=http://127.0.0.1:3001
# Optional and disabled by default. Allows an explicitly approved Node/npm project
# to be cloned and started in a dedicated temporary workspace on this computer.
ENABLE_LOCAL_EXECUTION=false
# Optional absolute directory. Defaults to the operating system temp directory.
REPOLENS_WORKSPACE_ROOT=
COPILOTKIT_TELEMETRY_DISABLED=true
DO_NOT_TRACK=1
