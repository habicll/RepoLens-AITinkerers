# Server only. Never prefix secrets with VITE_.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4
# Optional for public repositories; recommended for GitHub rate limits and code search.
GITHUB_TOKEN=
PORT=3001
HOST=127.0.0.1
# Optional comma-separated allowlist, e.g. owner/repo,another/repo
GITHUB_ALLOWED_REPOS=
# Chrome extension ID after loading the unpacked extension (optional for local development).
EXTENSION_ID=
# Only the public backend address is compiled into the extension.
VITE_API_URL=http://127.0.0.1:3001
COPILOTKIT_TELEMETRY_DISABLED=true
DO_NOT_TRACK=1
