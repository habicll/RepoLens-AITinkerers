{
  "name": "repolens",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build && node scripts/build-extension.mjs",
    "start": "tsx server/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@ag-ui/client": "0.0.59",
    "@ag-ui/core": "0.0.59",
    "@copilotkit/react-core": "1.71.1",
    "@copilotkit/runtime": "1.71.1",
    "dotenv": "16.6.1",
    "express": "4.22.2",
    "lucide-react": "0.468.0",
    "openai": "7.15.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "rxjs": "7.8.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@types/chrome": "0.0.287",
    "@types/express": "4.17.23",
    "@types/node": "22.18.6",
    "@types/react": "19.1.16",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "4.7.0",
    "concurrently": "9.2.4",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "6.4.3",
    "vitest": "3.2.7"
  }
}
